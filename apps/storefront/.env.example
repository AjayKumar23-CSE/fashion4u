# Base URL of the backend API, used during server rendering.
API_URL="http://localhost:4000/api/v1"
# The same API, as the browser reaches it (bag and checkout call it directly).
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Where uploaded images are served from. Must match S3_PUBLIC_URL in the API's
# .env, e.g. https://your-bucket.s3.ap-south-1.amazonaws.com
S3_PUBLIC_URL=""
