# ---------------------------------------------------------------------------
# Database. Pick ONE option. See docs/database.md.
#
# Option A (default, no Docker needed): `npm run db:dev` starts a local
# Postgres on the fixed ports below. Data is thrown away easily; use it for
# development, never for anything you want to keep.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Option B — Neon (hosted Postgres, keeps real data). Copy BOTH strings from
# the Neon dashboard and DELETE the two lines above, including
# SHADOW_DATABASE_URL, which only exists for the local server's quirks.
#   DATABASE_URL -> the POOLED string  (host contains "-pooler")
#   DIRECT_URL   -> the DIRECT string  (same host WITHOUT "-pooler")
# The app runs on the pooled one; migrations and seeding use the direct one,
# because a pooler in transaction mode cannot hold their locks.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Option C: `docker compose up -d` at the repo root, then use this instead
# and remove SHADOW_DATABASE_URL.
# DATABASE_URL="postgresql://store:store@localhost:5432/store?schema=public"
# ---------------------------------------------------------------------------

# The e2e suite writes categories, products and orders through the real API,
# so it is pinned to the local database and refuses to touch a remote one.
# Start it with `npm run db:dev` before `npm run test:e2e`.
TEST_DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

REDIS_URL="redis://localhost:6379"

PORT=4000
# Comma-separated origins allowed to call the API (storefront, admin).
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Staff tokens for the admin panel. Generate with: openssl rand -hex 32
JWT_SECRET="change-me"

# First admin account, created by `npm run db:seed` (role: OWNER).
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD="change-me-before-seeding"

# Image storage. Credentials are read by the AWS SDK from these two variables
# (or from an instance role in production).
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""
# Where uploaded images are served from, e.g.
# https://your-bucket.s3.ap-south-1.amazonaws.com (or a CloudFront domain).
S3_PUBLIC_URL=""
# Only for an S3-compatible server such as MinIO; leave unset for AWS.
# S3_ENDPOINT="http://localhost:9000"

# Razorpay. Test keys work immediately after signup (Settings -> API Keys);
# the key id is sent to the browser, the secret never leaves the server.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Set when you create the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=""
