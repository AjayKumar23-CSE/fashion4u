{
  "name": "clothing-store",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first clothing e-commerce store: storefront, admin panel and API",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run start:dev -w api",
    "dev:storefront": "npm run dev -w storefront",
    "dev:admin": "npm run dev -w admin",
    "build": "npm run build -w api && npm run build -w storefront && npm run build -w admin",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w api",
    "db:migrate": "npm run db:migrate -w api",
    "db:deploy": "npm run db:deploy --workspace api",
    "db:seed": "npm run db:seed -w api",
    "db:copy": "npm run db:copy --workspace api --",
    "db:studio": "npm run db:studio -w api",
    "db:dev": "npm run db:dev -w api",
    "db:dev:stop": "npm run db:dev:stop -w api",
    "images:to-s3": "npm run images:to-s3 -w api --"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  }
}
